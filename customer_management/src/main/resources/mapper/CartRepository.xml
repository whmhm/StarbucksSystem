<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.whm.starbucks.dao.CartRepository">
    <!-- 单参 POJO：keyProperty 直接写 id，自增主键回填到 cart.id，方法返回受影响行数 -->
    <insert id="addCart" parameterType="com.whm.starbucks.pojo.entity.Cart"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO cart (user_id, store_id)
        VALUES (#{userId}, #{storeId})
    </insert>

    <select id="getCart" resultType="com.whm.starbucks.pojo.entity.Cart">
        SELECT * FROM cart
        WHERE user_id = #{userId} AND store_id = #{storeId} AND is_deleted = 0
        LIMIT 1
    </select>
</mapper>
